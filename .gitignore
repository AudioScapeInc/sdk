# `*.rbxm` catches both Wally's package outputs and release artifacts
# built via `rojo build` (the release.yml workflow produces these in CI
# on tag push — they're attached to GitHub releases, not checked in).
*.rbxm
*.rbxl
*.rbxlx
.lune/

# Local-only secrets for integration tests + act --secret-file.
# `.env.integration.example` is tracked as a template; everything else is local.
.env.integration
.env.integration.local
.env.integration.*.local

