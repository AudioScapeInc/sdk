# Copy to `.env.integration` (gitignored), fill in real values. Sourced via
# `set -a; source .env.integration; set +a` for `lune run tests/openCloud/smoke.luau`,
# or fed to `act --secret-file .env.integration` for local CI runs.
#
# The AudioScape API key is NOT here — it lives as a Roblox Secret named
# `AUDIOSCAPE_KEY` on the test place (Creator Hub → your experience →
# Secrets). The smoke retrieves it via HttpService:GetSecret at runtime, so
# the key never flows through env vars or source code.
#
# Format: bash dotenv. Wrap values with spaces or shell metacharacters in
# double quotes. Asset/playlist IDs are discovered at test time via the SDK's
# own browse/sfxBrowse/listPlaylists endpoints — no fixture IDs needed.
#
# See CONTRIBUTING.md → "Open Cloud smoke — first-time setup" for how to
# provision the test place, API key scope, and Secret.

# Open Cloud API key with `universe.place.luau-execution-session:write` scope.
ROBLOX_API_KEY=

# Test universe + place. Must have HttpService enabled and have the
# AUDIOSCAPE_KEY Secret provisioned.
ROBLOX_TEST_UNIVERSE_ID=
ROBLOX_TEST_PLACE_ID=
